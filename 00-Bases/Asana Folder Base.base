views:
  - type: table
    name: Table
    filters:
      and:
        - file.folder == "02-Work/01 - Work Projects/00 - ASANA"
    order: []
    sort:
      - property: file.path
        direction: DESC
    columnSize:
      file.name: 122
  - type: cards
    name: Card
    order:
      - file.name
    sort:
      - property: file.size
        direction: DESC
    cardSize: 200
    imageFit: ""
    image: ""
