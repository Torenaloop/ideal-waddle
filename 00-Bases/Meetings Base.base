filters:
  and:
    - file.inFolder("02-Work")
    - type == "meeting"
properties:
  file.name:
    displayName: Meeting
  note.Meeting Type:
    displayName: Type
views:
  - type: table
    name: All Meetings
    order:
      - file.name
      - Date
      - Meeting Type
      - People
      - Site
    sort:
      - property: Date
        direction: DESC
  - type: table
    name: By Type
    groupBy:
      property: Meeting Type
      direction: ASC
    order:
      - file.name
      - Date
      - People
      - Site
    sort:
      - property: Date
        direction: DESC
  - type: table
    name: 1-on-1s
    filters:
      and:
        - note["Meeting Type"] == "1-on-1"
    groupBy:
      property: People
      direction: ASC
    order:
      - file.name
      - Date
      - Site
      - Status
    sort:
      - property: Date
        direction: DESC
  - type: table
    name: This Person
    filters:
      or:
        - list(People).contains(this)
        - file.hasLink(this.file)
    order:
      - file.name
      - Date
      - Meeting Type
      - People
    sort:
      - property: Date
        direction: DESC
  - type: table
    name: This Site
    filters:
      and:
        - Site == this
    order:
      - file.name
      - Date
      - Meeting Type
      - People
    sort:
      - property: Date
        direction: DESC
