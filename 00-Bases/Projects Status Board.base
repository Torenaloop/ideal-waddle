formulas:
  Last Modified: file.mtime.relative()
views:
  - type: cards
    name: Work Projects
    filters:
      and:
        - file.inFolder("02-Work/01 - Work Projects")
        - type == "project"
    groupBy:
      property: Status
      direction: ASC
    order:
      - file.name
      - Priority
      - Due Date
      - tags
    sort:
      - property: Priority
        direction: DESC
      - property: Due Date
        direction: ASC
    cardSize: 180
  - type: table
    name: All Work Projects
    filters:
      and:
        - file.inFolder("02-Work/01 - Work Projects")
        - type == "project"
    groupBy:
      property: Status
      direction: ASC
    order:
      - file.name
      - Status
      - Priority
      - Start Date
      - Due Date
      - Parent Goal
      - file.folder
      - formula.Last Modified
    sort:
      - property: Priority
        direction: DESC
      - property: Due Date
        direction: ASC
  - type: table
    name: Needs Triage
    filters:
      and:
        - file.inFolder("02-Work/01 - Work Projects")
        - '!file.hasProperty("type")'
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - PARA
      - Status
      - formula.Last Modified
    sort:
      - property: file.mtime
        direction: DESC
  - type: cards
    name: Personal Projects
    filters:
      and:
        - file.inFolder("01-Personal/01-Projects")
    groupBy:
      property: Status
      direction: ASC
    order:
      - file.name
      - Priority
      - Due Date
      - tags
    sort:
      - property: Priority
        direction: DESC
      - property: Due Date
        direction: ASC
    cardSize: 180
