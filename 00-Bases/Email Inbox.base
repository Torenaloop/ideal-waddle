filters:
  and:
    - file.inFolder("02-Work")
    - type == "email"
formulas:
  Received: if(Date, Date.relative())
views:
  - type: cards
    name: Inbox Board
    groupBy:
      property: Status
      direction: ASC
    order:
      - file.name
      - Sender
      - Priority
      - Due Date
      - formula.Received
    sort:
      - property: Priority
        direction: DESC
      - property: Due Date
        direction: ASC
    cardSize: 180
  - type: table
    name: All Emails
    groupBy:
      property: Status
      direction: ASC
    order:
      - file.name
      - Sender
      - Subject
      - Priority
      - Status
      - Date
      - Due Date
      - Project
      - formula.Received
    sort:
      - property: Date
        direction: DESC
