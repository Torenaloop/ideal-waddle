filters:
  and:
    - type == "person"
properties:
  file.name:
    displayName: Name
  note.Job Title:
    displayName: Title
  note.Reports to:
    displayName: Reports to
views:
  - type: table
    name: By Site
    groupBy:
      property: Location
      direction: ASC
    order:
      - file.name
      - Job Title
      - Org
      - Reports to
      - Email
      - Phone
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: By Org
    groupBy:
      property: Org
      direction: ASC
    order:
      - file.name
      - Job Title
      - Location
      - Reports to
      - Email
    sort:
      - property: file.name
        direction: ASC
  - type: cards
    name: Cards
    order:
      - file.name
      - Job Title
      - Location
    sort:
      - property: file.name
        direction: ASC
