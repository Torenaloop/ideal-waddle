filters:
  and:
    - file.inFolder("02-Work/02 - Work Areas")
formulas:
  Last Modified: file.mtime.relative()
views:
  - type: table
    name: Site Hubs
    filters:
      and:
        - type == "hub"
    order:
      - file.name
      - Site
      - Status
      - tags
      - formula.Last Modified
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: All Site Content
    groupBy:
      property: Site
      direction: ASC
    order:
      - file.name
      - type
      - Status
      - Date
      - formula.Last Modified
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Site 1-on-1s
    filters:
      and:
        - type == "meeting"
    groupBy:
      property: Site
      direction: ASC
    order:
      - file.name
      - Date
      - People
      - Status
    sort:
      - property: Date
        direction: DESC
  - type: cards
    name: Cards
    groupBy:
      property: Site
      direction: ASC
    order:
      - file.name
      - type
    cardSize: 160
