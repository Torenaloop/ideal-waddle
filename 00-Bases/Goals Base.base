filters:
  and:
    - file.inFolder("02-Work")
    - type == "goal"
properties:
  file.name:
    displayName: Goal
  note.Goal Number:
    displayName: "#"
views:
  - type: table
    name: Cascade
    groupBy:
      property: Parent Goal
      direction: ASC
    order:
      - file.name
      - Goal Number
      - Status
      - Priority
      - Category
      - Employee
      - Manager
      - Year
    sort:
      - property: Goal Number
        direction: ASC
  - type: table
    name: By Manager
    groupBy:
      property: Manager
      direction: ASC
    order:
      - file.name
      - Employee
      - Goal Number
      - Status
      - Priority
      - Parent Goal
    sort:
      - property: Goal Number
        direction: ASC
  - type: table
    name: By Status
    groupBy:
      property: Status
      direction: ASC
    order:
      - file.name
      - Goal Number
      - Priority
      - Employee
      - Manager
      - Quarter
      - Parent Goal
    sort:
      - property: Priority
        direction: DESC
  - type: table
    name: In Progress
    filters:
      and:
        - Status == "In Progress"
    order:
      - file.name
      - Goal Number
      - Priority
      - Employee
      - Manager
      - Parent Goal
    sort:
      - property: Priority
        direction: DESC
  - type: table
    name: Sub-goals of This Note
    filters:
      and:
        - list(note["Parent Goal"]).contains(this)
    order:
      - file.name
      - Goal Number
      - Status
      - Priority
    sort:
      - property: Goal Number
        direction: ASC
