formulas:
  Untitled: ""
views:
  - type: table
    name: Table
    filters:
      and:
        - file.folder.contains("Donna Goals")
    order:
      - file.name
      - tags
      - file.links
      - 2025 Goal
      - Mission Pillar
    sort:
      - property: Mission Pillar
        direction: DESC
      - property: formula.Untitled
        direction: ASC
      - property: file.name
        direction: ASC
      - property: file.tags
        direction: ASC
    columnSize:
      file.name: 149
      note.2025 Goal: 123
      note.Goal Name: 145
      note.tags: 574
      file.links: 826
      note.Mission Pillar: 122
  - type: cards
    name: View
    cardSize: 170
    imageFit: ""
