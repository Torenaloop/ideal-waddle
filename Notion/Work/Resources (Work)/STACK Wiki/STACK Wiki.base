# STACK Wiki

filters:
  and:
    - note["base"] == link("STACK Wiki.base")
properties:
  file.name:
    displayName: Page
  Tags:
    displayName: Tags
  Created time:
    displayName: Created time
  Last edited time:
    displayName: Last edited time
  Verification:
    displayName: Verification
  Owner:
    displayName: Owner
views:
  - type: table
    name: Table View
    order:
      - file.name
      - Tags
      - Created time
      - Last edited time
      - Verification
      - Owner
