# KTBR

filters:
  and:
    - note["base"] == link("KTBR.base")
properties:
  file.name:
    displayName: Task name
  Created time:
    displayName: Created time
  Project:
    displayName: Project
  Tags:
    displayName: Tags
  Assignee:
    displayName: Assignee
  Status:
    displayName: Status
  Due:
    displayName: Due
  Summary:
    displayName: Summary
views:
  - type: table
    name: Table View
    order:
      - file.name
      - Created time
      - Project
      - Tags
      - Assignee
      - Status
      - Due
      - Summary
