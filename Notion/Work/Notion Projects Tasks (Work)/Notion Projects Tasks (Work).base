# Notion Projects Tasks (Work)

filters:
  and:
    - note["base"] == link("Notion Projects Tasks (Work).base")
properties:
  file.name:
    displayName: Task name
  Document Category:
    displayName: Document Category
  Review By:
    displayName: Review By
  Approval Date:
    displayName: Approval Date
  Approver:
    displayName: Approver
  Document Approved:
    displayName: Document Approved
  Reviewer:
    displayName: Reviewer
  Tags:
    displayName: Tags
  Assignee:
    displayName: Assignee
  Status:
    displayName: Status
  Due:
    displayName: Due
  Priority:
    displayName: Priority
  Sub-tasks:
    displayName: Sub-tasks
  Summary:
    displayName: Summary
  Parent-task:
    displayName: Parent-task
  Project:
    displayName: Project
views:
  - type: table
    name: Table View
    order:
      - file.name
      - Document Category
      - Review By
      - Approval Date
      - Approver
      - Document Approved
      - Reviewer
      - Tags
      - Assignee
      - Status
      - Due
      - Priority
      - Sub-tasks
      - Summary
      - Parent-task
      - Project
