# Videos Database

filters:
  and:
    - note["base"] == link("Videos Database.base")
properties:
  file.name:
    displayName: Name
  Links:
    displayName: Links
  Topic:
    displayName: Topic
  Author:
    displayName: Author
views:
  - type: table
    name: Table View
    order:
      - file.name
      - Links
      - Topic
      - Author
