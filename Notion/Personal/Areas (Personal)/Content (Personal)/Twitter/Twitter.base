# Twitter

filters:
  and:
    - note["base"] == link("Twitter.base")
properties:
  file.name:
    displayName: Topic
  Notes:
    displayName: Notes
  Viewed:
    displayName: Viewed
  Link:
    displayName: Link
  Date:
    displayName: Date
  Author:
    displayName: Author
  Tags:
    displayName: Tags
views:
  - type: table
    name: Table View
    order:
      - file.name
      - Notes
      - Viewed
      - Link
      - Date
      - Author
      - Tags
