# New database

filters:
  and:
    - note["base"] == link("New database.base")
properties:
  file.name:
    displayName: Slide
  Role:
    displayName: Role
  VARK:
    displayName: VARK
  Notes:
    displayName: Notes
  Subtopics:
    displayName: Subtopics
  AKSM:
    displayName: AKSM
  PPT Complete:
    displayName: PPT Complete
  Minutes:
    displayName: Minutes
views:
  - type: table
    name: Table View
    order:
      - file.name
      - Role
      - VARK
      - Notes
      - Subtopics
      - AKSM
      - PPT Complete
      - Minutes
