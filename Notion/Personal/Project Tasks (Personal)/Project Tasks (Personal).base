filters:
  and:
    - note["base"] == link("Project Tasks (Personal).base")
properties:
  file.name:
    displayName: Task name
  Tags:
    displayName: Tags
  Assignee:
    displayName: Assignee
  Status:
    displayName: Status
  Due:
    displayName: Due
  Priority:
    displayName: Priority
  Sub-tasks:
    displayName: Sub-tasks
  Summary:
    displayName: Summary
  Parent-task:
    displayName: Parent-task
  Project:
    displayName: Project
views:
  - type: table
    name: Table View
    filters:
      and:
        - Status != "Done"
    order:
      - file.name
      - tags
      - Project
      - Assignee
      - Status
      - Due
      - Priority
      - Sub-tasks
      - Summary
      - Parent-task
    sort: []
