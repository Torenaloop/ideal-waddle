# Crap I want to buy

filters:
  and:
    - note["base"] == link("Crap I want to buy.base")
properties:
  file.name:
    displayName: Name
  Date Created:
    displayName: Date Created
  Link:
    displayName: Link
  Status:
    displayName: Status
  Type:
    displayName: Type
  Price:
    displayName: Price
views:
  - type: table
    name: Table View
    order:
      - file.name
      - Date Created
      - Link
      - Status
      - Type
      - Price
