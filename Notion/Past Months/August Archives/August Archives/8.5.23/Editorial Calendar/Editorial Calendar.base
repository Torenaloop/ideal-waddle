# Editorial Calendar

filters:
  and:
    - note["base"] == link("Editorial Calendar.base")
properties:
  file.name:
    displayName: Name
  Writers:
    displayName: Writers
  Deadline:
    displayName: Deadline
  Publication Date:
    displayName: Publication Date
  URL:
    displayName: URL
  Editors:
    displayName: Editors
  Status:
    displayName: Status
  Tags:
    displayName: Tags
views:
  - type: table
    name: Table View
    order:
      - file.name
      - Writers
      - Deadline
      - Publication Date
      - URL
      - Editors
      - Status
      - Tags
