# Tasks (1)

filters:
  and:
    - note["base"] == link("Tasks (1).base")
properties:
  file.name:
    displayName: Task name
  Tags:
    displayName: Tags
  Assignee:
    displayName: Assignee
  Status:
    displayName: Status
  Due:
    displayName: Due
  Priority:
    displayName: Priority
  Sub-tasks:
    displayName: Sub-tasks
  Parent-task:
    displayName: Parent-task
  Project:
    displayName: Project
views:
  - type: table
    name: Table View
    order:
      - file.name
      - Tags
      - Assignee
      - Status
      - Due
      - Priority
      - Sub-tasks
      - Parent-task
      - Project
