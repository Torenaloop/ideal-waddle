# Tasks (2)

filters:
  and:
    - note["base"] == link("Tasks (2).base")
formulas:
  Is Current Sprint: note["Sprint"].map(value.asFile().properties["Is Current Sprint"])
properties:
  file.name:
    displayName: Task name
  Tags:
    displayName: Tags
  Assignee:
    displayName: Assignee
  Status:
    displayName: Status
  Due:
    displayName: Due
  Priority:
    displayName: Priority
  Sub-tasks:
    displayName: Sub-tasks
  Parent-task:
    displayName: Parent-task
  Sprint:
    displayName: Sprint
  Project:
    displayName: Project
views:
  - type: table
    name: Table View
    order:
      - file.name
      - Tags
      - Assignee
      - Status
      - Due
      - Priority
      - Sub-tasks
      - Parent-task
      - Sprint
      - Project
      - formula.Is Current Sprint
