# Tasks

filters:
  and:
    - note["base"] == link("Tasks.base")
properties:
  file.name:
    displayName: Task name
  Tags:
    displayName: Tags
  Assignee:
    displayName: Assignee
  Status:
    displayName: Status
  Due:
    displayName: Due
  Priority:
    displayName: Priority
  Sub-tasks:
    displayName: Sub-tasks
  Summary:
    displayName: Summary
  Parent-task:
    displayName: Parent-task
  Sprint:
    displayName: Sprint
  Project:
    displayName: Project
  Task ID:
    displayName: Task ID
  GitHub Pull Requests:
    displayName: GitHub Pull Requests
views:
  - type: table
    name: Table View
    order:
      - file.name
      - Tags
      - Assignee
      - Status
      - Due
      - Priority
      - Sub-tasks
      - Summary
      - Parent-task
      - Sprint
      - Project
      - Task ID
      - GitHub Pull Requests
