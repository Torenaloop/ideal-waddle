views:
  - type: table
    name: Table
    filters:
      and:
        - file.folder == "02-Work/06-Work Person/STACK People"
    groupBy:
      property: Location
      direction: ASC
    order:
      - file.name
      - Location
      - Job Title
      - Email
      - Org
      - tags
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      note.location: 207
      note.Org: 87
  - type: cards
    name: Cards
    filters:
      and:
        - file.inFolder("02-Work/08-Work Person/STACK People")
